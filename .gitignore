# CMake / 构建产物
build/
cmake-build-*/
out/

# Visual Studio 临时文件
*.user
*.suo
.vs/

# 临时测试脚本与截图(自动化验证用,不进仓库)
*.ps1
shot_*.png
.commitmsg.txt

# KiCad 打开工程时的临时锁文件
~*.lck
*.kicad_prl
~*.kicad_pcb.lck

# KiCad 的自动备份目录
.history/

# 例外:一键编译脚本要进仓库(其余 .ps1 是调试脚本,不进仓库)
!build.ps1

# 例外:文档配图的生成脚本要进仓库
!tools/*.ps1

# Shared update entry point
!update-and-run.ps1

# Packaged demonstration builds
dist/
